{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frootai.dev/schemas/agent-fai-offline-knowledge.v1.json",
  "title": "Agent FAI Offline Knowledge v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "source", "freshnessPolicy", "uafCompatibility", "schemas", "plays"],
  "properties": {
    "schemaVersion": { "const": "agent-fai-offline-knowledge.v1" },
    "profile": { "const": "offline" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "tree", "path", "gitBlobOid", "sha256", "sourceUpdatedAt"],
      "properties": {
        "repository": { "const": "https://github.com/frootai/frootai-core.git" },
        "commit": { "$ref": "#/$defs/gitOid" }, "tree": { "$ref": "#/$defs/gitOid" }, "path": { "const": "npm-mcp/index.js" },
        "gitBlobOid": { "$ref": "#/$defs/gitOid" }, "sha256": { "$ref": "#/$defs/sha256" }, "sourceUpdatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "freshnessPolicy": {
      "type": "object", "additionalProperties": false, "required": ["maximumAgeDays", "staleBehavior"],
      "properties": { "maximumAgeDays": { "const": 30 }, "staleBehavior": { "const": "label-stale-never-refresh-or-fallback-silently" } }
    },
    "uafCompatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["offlineAdapters", "adapterStatus", "capabilityStatus", "profileReadiness", "supportedCapabilities", "readinessPromoted", "sourceInputs"],
      "properties": {
        "offlineAdapters": { "const": 7 }, "adapterStatus": { "const": "Degraded" }, "capabilityStatus": { "const": "Degraded" },
        "profileReadiness": { "const": "Designed" }, "supportedCapabilities": { "const": 0 }, "readinessPromoted": { "const": false },
        "sourceInputs": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/localSource" } }
      }
    },
    "schemas": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/schemaEntry" } },
    "plays": { "type": "array", "minItems": 100, "maxItems": 100, "items": { "$ref": "#/$defs/play" } }
  },
  "$defs": {
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "localSource": { "type": "object", "additionalProperties": false, "required": ["task", "packagePath", "packageSha256", "sourcePath", "sourceSha256", "authorityState"], "properties": { "task": { "enum": ["UAF-T019", "UAF-T021", "UAF-T022"] }, "packagePath": { "type": "string", "pattern": "^lib/agent/offline-authority/" }, "packageSha256": { "$ref": "#/$defs/sha256" }, "sourcePath": { "type": "string", "pattern": "^planning/unified-ai-fabric-foundation/" }, "sourceSha256": { "$ref": "#/$defs/sha256" }, "authorityState": { "const": "local-approved-uncommitted" } } },
    "schemaEntry": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }, "path": { "type": "string", "pattern": "^(?:commands|lib)/agent/" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "play": { "type": "object", "additionalProperties": false, "required": ["id", "name", "services", "pattern", "complexity"], "properties": { "id": { "type": "string", "pattern": "^(?:0[1-9]|[1-9][0-9]|100)$" }, "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "services": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }, "pattern": { "type": "string", "minLength": 3, "maxLength": 1024 }, "complexity": { "enum": ["Low", "Medium", "High", "Very High", "Foundation"] } } }
  }
}