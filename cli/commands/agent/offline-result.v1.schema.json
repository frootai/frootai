{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frootai.dev/schemas/agent-fai-offline-result.v1.json",
  "title": "Agent FAI Offline Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "query", "knowledge", "provenance", "capabilities", "matches", "schemas", "limitations", "prohibitedClaims"],
  "properties": {
    "schemaVersion": { "const": "agent-fai-offline-result.v1" }, "profile": { "const": "offline" },
    "query": { "type": ["string", "null"], "maxLength": 8000 },
    "knowledge": { "type": "object", "additionalProperties": false, "required": ["digest", "sourceCommit", "sourceBlob", "sourceUpdatedAt", "observedDate", "ageDays", "maximumAgeDays", "freshness"], "properties": { "digest": { "$ref": "#/$defs/sha256" }, "sourceCommit": { "$ref": "#/$defs/gitOid" }, "sourceBlob": { "$ref": "#/$defs/gitOid" }, "sourceUpdatedAt": { "type": "string", "format": "date-time" }, "observedDate": { "type": "string", "format": "date" }, "ageDays": { "type": "integer", "minimum": 0 }, "maximumAgeDays": { "const": 30 }, "freshness": { "enum": ["current", "stale"] } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["authorityState", "inputs"], "properties": { "authorityState": { "const": "local-approved-uncommitted" }, "inputs": { "type": "array", "prefixItems": [
      { "$ref": "#/$defs/uafT019" }, { "$ref": "#/$defs/uafT021" }, { "$ref": "#/$defs/uafT022" }
    ], "items": false, "minItems": 3, "maxItems": 3 } } },
    "capabilities": { "type": "object", "additionalProperties": false, "required": ["available", "unavailable", "networkAttempts", "uafStatus", "profileReadiness"], "properties": { "available": { "const": ["packaged-solution-play-discovery", "packaged-schema-inventory", "deterministic-capability-report"] }, "unavailable": { "const": ["live-agent-fai", "live-model-judgment", "current-cloud-state", "current-pricing", "profile-readiness", "successful-remote-validation", "network-backed-grounding", "authentication", "mcp", "telemetry", "updates"] }, "networkAttempts": { "const": 0 }, "uafStatus": { "const": "Degraded" }, "profileReadiness": { "const": "Designed" } } },
    "matches": { "type": "array", "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "score", "complexity", "evidence"], "properties": { "id": { "type": "string", "pattern": "^(?:0[1-9]|[1-9][0-9]|100)$" }, "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "score": { "type": "integer", "minimum": 0 }, "complexity": { "enum": ["Low", "Medium", "High", "Very High", "Foundation"] }, "evidence": { "const": "packaged-public-play-index" } } } },
    "schemas": { "type": "array", "prefixItems": [
      { "$ref": "#/$defs/schemaOpenApi" }, { "$ref": "#/$defs/schemaRenderResult" }, { "$ref": "#/$defs/schemaGeneratedContracts" }, { "$ref": "#/$defs/schemaOfflineKnowledge" }
    ], "items": false, "minItems": 4, "maxItems": 4 },
    "limitations": { "const": ["Packaged public knowledge may be stale and is never refreshed during offline execution.", "Results are deterministic lexical matches, not live model judgment or current grounding.", "UAF offline adapters are Degraded, the profile is Designed, and zero capabilities are Supported.", "No current cloud state, pricing, readiness, remote validation, authentication, MCP, telemetry, or updates are available."] },
    "prohibitedClaims": { "const": ["live-model-judgment", "current-cloud-state", "current-pricing", "profile-readiness", "successful-remote-validation", "network-backed-grounding"] }
  },
  "$defs": {
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uafT019": { "type": "object", "additionalProperties": false, "required": ["task", "packagePath", "packageSha256", "sourcePath", "sourceSha256", "authorityState"], "properties": { "task": { "const": "UAF-T019" }, "packagePath": { "const": "lib/agent/offline-authority/uaf-t019-limitations.v1.json" }, "packageSha256": { "const": "687fa92727cf009c6017388ce47d0ad5919fc3bd68d91fa7cd20e03c19ff8091" }, "sourcePath": { "const": "planning/unified-ai-fabric-foundation/uaf-t019-contract-artifact.v1.json" }, "sourceSha256": { "const": "cbaf02f625038e4181a6cfcdf82587a179ccb0497879bcc95b0ec1f5936799f5" }, "authorityState": { "const": "local-approved-uncommitted" } } },
    "uafT021": { "type": "object", "additionalProperties": false, "required": ["task", "packagePath", "packageSha256", "sourcePath", "sourceSha256", "authorityState"], "properties": { "task": { "const": "UAF-T021" }, "packagePath": { "const": "lib/agent/offline-authority/uaf-t021-limitations.v1.json" }, "packageSha256": { "const": "9224c1c495ce19c4bf0d9e579b3fa92c3da9a2171bfdc75dd755f65840227323" }, "sourcePath": { "const": "planning/unified-ai-fabric-foundation/uaf-t021-contract-artifact.v1.json" }, "sourceSha256": { "const": "637dc638df8a8eedd409a08fe21f3f5fe0dc1d13229028dcb8c415c08a5075bf" }, "authorityState": { "const": "local-approved-uncommitted" } } },
    "uafT022": { "type": "object", "additionalProperties": false, "required": ["task", "packagePath", "packageSha256", "sourcePath", "sourceSha256", "authorityState"], "properties": { "task": { "const": "UAF-T022" }, "packagePath": { "const": "lib/agent/offline-authority/uaf-t022-limitations.v1.json" }, "packageSha256": { "const": "d7e25b594286b7bfe8283a1e5a4240f917f8b765061d45aef96aa0038b7e38c2" }, "sourcePath": { "const": "planning/unified-ai-fabric-foundation/uaf-t022-contract-artifact.v1.json" }, "sourceSha256": { "const": "77092abf1effa132e0db094547f23b11aa832c5da69730c2edb1dc84fd03b10f" }, "authorityState": { "const": "local-approved-uncommitted" } } },
    "schemaOpenApi": { "$ref": "#/$defs/schemaBase", "properties": { "id": { "const": "agent-fai-openapi.v1" }, "path": { "const": "commands/agent/agent-fai-v1.openapi.json" }, "sha256": { "const": "ed31d1dbd9a70770bf1cbdcc85d2ee10d25c8dabf8fffdd3b3cebed860fe4c2f" } } },
    "schemaRenderResult": { "$ref": "#/$defs/schemaBase", "properties": { "id": { "const": "agent-fai-render-result.v1" }, "path": { "const": "commands/agent/render-result.v1.schema.json" }, "sha256": { "const": "f6aa0d9b520f598872c6357346f10ac37e3cb5be84b1ecae893cc40781abdfe1" } } },
    "schemaGeneratedContracts": { "$ref": "#/$defs/schemaBase", "properties": { "id": { "const": "agent-fai-generated-contracts.v1" }, "path": { "const": "lib/agent/contracts/manifest.v1.json" }, "sha256": { "const": "49d48f1c1b03f9324f5d70b366cca3fde648c1ab752537b2989085e401831bfb" } } },
    "schemaOfflineKnowledge": { "$ref": "#/$defs/schemaBase", "properties": { "id": { "const": "agent-fai-offline-knowledge.v1" }, "path": { "const": "commands/agent/offline-knowledge.v1.schema.json" }, "sha256": { "const": "40cbc82820f81035489431fdbe2bdcf0a4b765e5ef6fd7d287e7b3fd6aec7cac" } } },
    "schemaBase": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": true, "path": true, "sha256": true } }
  }
}
