{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frootai.dev/schemas/agent-fai-render-result.v1.json",
  "title": "Agent FAI CLI Render Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "identity", "content", "sources", "artifacts", "evidence", "usage", "diagnostics", "semanticDigest", "delivery"],
  "properties": {
    "schemaVersion": { "const": "agent-fai-render-result.v1" },
    "status": { "enum": ["completed", "cancelled", "failed"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "sessionId", "turnId"],
      "properties": {
        "requestId": { "$ref": "#/$defs/uuid" },
        "sessionId": { "$ref": "#/$defs/uuid" },
        "turnId": { "$ref": "#/$defs/uuid" }
      }
    },
    "content": { "type": "string", "maxLength": 2097152 },
    "sources": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/source" } },
    "artifacts": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/artifact" } },
    "evidence": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/evidence" } },
    "usage": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/uuid" } },
    "diagnostics": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/diagnostic" } },
    "semanticDigest": { "$ref": "#/$defs/sha256" },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveredCount", "acceptedCount", "duplicateCount", "firstSequence", "lastSequence"],
      "properties": {
        "deliveredCount": { "type": "integer", "minimum": 1 },
        "acceptedCount": { "type": "integer", "minimum": 1 },
        "duplicateCount": { "type": "integer", "minimum": 0 },
        "firstSequence": { "type": "integer", "minimum": 1 },
        "lastSequence": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["sourceId", "category", "href", "rank"],
      "properties": { "sourceId": { "type": "string" }, "category": { "type": "string" }, "href": { "type": "string", "pattern": "^https://" }, "rank": { "type": "integer", "minimum": 1 } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["artifactId", "digest"],
      "properties": { "artifactId": { "$ref": "#/$defs/uuid" }, "digest": { "$ref": "#/$defs/sha256" } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["evidenceId", "digest"],
      "properties": { "evidenceId": { "$ref": "#/$defs/uuid" }, "digest": { "$ref": "#/$defs/sha256" } }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["type", "code", "messageCode"],
      "properties": { "type": { "enum": ["warning", "limitation"] }, "code": { "type": "string" }, "messageCode": { "type": "string" } }
    }
  }
}