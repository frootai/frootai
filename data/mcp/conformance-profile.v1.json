  "matrix": [
    { "id": "request-metadata", "layer": "base", "status": "required", "methods": ["*"], "requirement": "Every request carries the current protocol version and client capabilities in params._meta; client identity remains recommended." },
    { "id": "server-discovery", "layer": "base", "status": "required", "methods": ["server/discover"], "requirement": "Servers expose supported versions and capabilities through server/discover; modern clients may probe and cache the response." },
    { "id": "stdio", "layer": "transport", "status": "required", "methods": ["stdio"], "requirement": "Local process integrations use newline-delimited JSON-RPC over stdin and stdout while diagnostics stay off the protocol stream." },
    { "id": "streamable-http", "layer": "transport", "status": "required", "methods": ["POST", "GET"], "requirement": "Remote integrations use Streamable HTTP with JSON POST and optional SSE response streams, authorization, origin, and media-type validation." },
    { "id": "tools", "layer": "server", "status": "required", "methods": ["tools/list", "tools/call"], "requirement": "Tool discovery is paginated and every invocation validates arguments against JSON Schema before bounded execution." },
    { "id": "resources", "layer": "server", "status": "optional", "methods": ["resources/list", "resources/read"], "requirement": "Resource providers declare capability support and expose only authorized, bounded, provenance-bearing context." },
    { "id": "prompts", "layer": "server", "status": "optional", "methods": ["prompts/list", "prompts/get"], "requirement": "Prompt providers declare capability support and treat returned templates as context rather than executable authority." },
    { "id": "elicitation", "layer": "client", "status": "optional", "methods": ["elicitation/create"], "requirement": "Servers request user input through multi-round-trip elicitation only when clients advertise the capability on that request." },
    { "id": "pagination", "layer": "utility", "status": "required", "methods": ["cursor", "nextCursor"], "requirement": "List operations accept opaque cursors and return nextCursor without clients interpreting or constructing cursor values." },
    { "id": "completion", "layer": "utility", "status": "optional", "methods": ["completion/complete"], "requirement": "Completion is capability-gated and returns bounded suggestions without granting execution or data-access authority." },
    { "id": "caching", "layer": "utility", "status": "optional", "methods": ["ttlMs", "cacheScope"], "requirement": "Clients honor server freshness and cache-scope hints while partitioning unverified server identities and invalidating stale discovery." },
    { "id": "progress", "layer": "utility", "status": "optional", "methods": ["notifications/progress"], "requirement": "Bounded operations may report correlated progress, but progress notifications never replace durable Tasks for long-running work." },
    { "id": "cancellation", "layer": "utility", "status": "required", "methods": ["notifications/cancelled"], "requirement": "Clients can cancel in-flight requests and servers contain cancellation to the originating request and release owned resources." },
    { "id": "subscriptions", "layer": "utility", "status": "optional", "methods": ["subscriptions/listen", "notifications/subscriptions/acknowledged"], "requirement": "Change notifications require explicit subscription, acknowledgement, capability support, correlation, reconnection, and polling fallback." },
    { "id": "authorization", "layer": "transport", "status": "optional", "methods": ["OAuth 2.1", "RFC 9728"], "requirement": "Remote protected resources use standards-based authorization with resource binding, audience validation, least privilege, and user consent." },
    { "id": "roots", "layer": "client", "status": "deprecated", "methods": ["roots/list"], "requirement": "New current-protocol implementations do not depend on roots; legacy adapters may expose it only for negotiated 2025 sessions." },
    { "id": "sampling", "layer": "client", "status": "deprecated", "methods": ["sampling/createMessage"], "requirement": "New implementations call model providers directly and do not use sampling as a production dependency on the current protocol." },
    { "id": "logging", "layer": "utility", "status": "deprecated", "methods": ["logging/setLevel", "notifications/message"], "requirement": "New implementations log to stderr for stdio or emit OpenTelemetry instead of depending on protocol logging messages." },
    { "id": "tasks", "layer": "extension", "status": "extension", "methods": ["tasks/get", "tasks/update", "tasks/cancel", "notifications/tasks"], "requirement": "Long-running work uses Tasks only through explicit client/server extension negotiation and a project-owned adapter with durable state." }
  ],
