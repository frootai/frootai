{
  "name": "@frootai/eval-sdk",
  "version": "0.1.0",
  "description": "FrootAI Eval-as-Service SDK — run eval suites, fetch datasets, manage scheduled runs, and mint CI tokens against the FrootAI Cloud eval API. Zero-dependency, typed, works in Node 18+ and edge runtimes.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "frootai",
    "fai",
    "eval",
    "evaluation",
    "llm-eval",
    "agent-eval",
    "groundedness",
    "regression",
    "ai",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/frootai/frootai",
    "directory": "eval-sdk"
  },
  "homepage": "https://frootai.dev/methodology/eval",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  }
}
