{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frootai.dev/schemas/solution-play-index.v1.json",
  "title": "FrootAI Solution Play Index",
  "description": "Canonical identity and link projection generated from the public solution-plays directory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "count", "plays"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "const": "frootai/solution-plays"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 101
    },
    "plays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 101,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/play"
      }
    }
  },
  "$defs": {
    "play": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "numeric_id",
        "slug",
        "name",
        "description",
        "relative_path",
        "readme_path",
        "spec_path",
        "spec_version",
        "github_url",
        "detail_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(0[1-9]|[1-9][0-9]|10[01])$"
        },
        "numeric_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 101
        },
        "slug": {
          "type": "string",
          "pattern": "^(0[1-9]|[1-9][0-9]|10[01])-[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "relative_path": {
          "type": "string",
          "pattern": "^solution-plays/(0[1-9]|[1-9][0-9]|10[01])-[a-z0-9][a-z0-9-]*$"
        },
        "readme_path": {
          "type": "string",
          "pattern": "^solution-plays/(0[1-9]|[1-9][0-9]|10[01])-[a-z0-9][a-z0-9-]*/README\\.md$"
        },
        "spec_path": {
          "type": "string",
          "pattern": "^solution-plays/(0[1-9]|[1-9][0-9]|10[01])-[a-z0-9][a-z0-9-]*/spec/play-spec\\.json$"
        },
        "spec_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "github_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/frootai/frootai/tree/main/solution-plays/"
        },
        "detail_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://frootai\\.dev/solution-plays/"
        }
      }
    }
  }
}
