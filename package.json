    "quality:solution-plays:strict": "node scripts/solution-play-quality-gate.mjs --strict",
    "quality:solution-plays:baseline": "node scripts/solution-play-quality-gate.mjs --write-baseline",
    "test:contract-inventory": "node --test scripts/test-solution-play-contract-inventory.mjs",
    "test:solution-play-schemas": "node --test scripts/test-solution-play-vnext-schemas.mjs",
    "validate:solution-play-delivery-profile": "node scripts/validate-solution-play-delivery-profile.mjs",
    "test:solution-play-delivery-profile": "node --test scripts/test-solution-play-delivery-profile.mjs",
    "validate:solution-play-telemetry": "node scripts/solution-play-telemetry.mjs",
    "test:solution-play-telemetry": "node --test scripts/test-solution-play-telemetry.mjs",
    "validate:solution-play-evaluation": "node scripts/solution-play-evaluation.mjs",
    "test:solution-play-evaluation": "node --test scripts/test-solution-play-evaluation.mjs",
    "validate:solution-play-identity": "node scripts/solution-play-identity.mjs",
    "test:solution-play-identity": "node --test scripts/test-solution-play-identity.mjs",
    "validate:solution-play-operations": "node scripts/solution-play-operations.mjs",
    "test:solution-play-operations": "node --test scripts/test-solution-play-operations.mjs",
    "test:solution-play-certification-harness": "node --test scripts/test-solution-play-certification-harness.mjs",
    "generate:solution-play-github-adapter": "node scripts/solution-play-github-adapter.mjs",
    "validate:solution-play-github-adapter": "node scripts/validate-solution-play-github-adapter.mjs",
    "test:solution-play-github-adapter": "node --test scripts/test-solution-play-github-adapter.mjs",
    "test:solution-play-github-conformance": "node --test scripts/test-solution-play-github-conformance.mjs",
    "generate:solution-play-claude-foundation": "node scripts/solution-play-claude-foundation.mjs",
    "validate:solution-play-claude-foundation": "node scripts/validate-solution-play-claude-foundation.mjs",
    "test:solution-play-claude-foundation": "node --test scripts/test-solution-play-claude-foundation.mjs",
    "generate:solution-play-claude-plugin": "node scripts/solution-play-claude-plugin.mjs",
    "validate:solution-play-claude-plugin": "node scripts/validate-solution-play-claude-plugin.mjs",
    "test:solution-play-claude-plugin": "node --test scripts/test-solution-play-claude-plugin.mjs",
    "test:evidence-v2-migration": "node --test scripts/test-solution-play-evidence-v2-migration.mjs",
    "test:solution-play-quality": "node --test scripts/test-solution-play-quality-gate.mjs",
    "test:engine-corpus": "node --test scripts/test-solution-play-engine-corpus.mjs",
    "certification:build": "node scripts/build-solution-play-certification.mjs",
    "certification:check": "node scripts/build-solution-play-certification.mjs --check",
    "certification:verify": "node scripts/solution-play-certification.mjs",
    "test:certification": "node --test scripts/test-solution-play-certification.mjs scripts/test-solution-play-certification-index.mjs",
