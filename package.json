{
  "name": "frootai",
  "version": "0.0.0",
  "private": true,
  "description": "FrootAI™ — From the Roots to the Fruits. Monorepo for MCP server, VS Code extension, website, and CLI.",
  "scripts": {
    "validate": "node scripts/validate-consistency.js",
    "validate:primitives": "node scripts/validate-primitives.js",
    "validate:primitives:verbose": "node scripts/validate-primitives.js --verbose",
    "build:solution-play-index": "node scripts/build-solution-play-index.mjs",
    "check:solution-play-index": "node scripts/build-solution-play-index.mjs --check",
    "test:solution-play-index": "node --test scripts/test-solution-play-index.mjs",
    "generate:marketplace": "node scripts/generate-marketplace.js",
    "generate:website-data": "node scripts/generate-website-data.js",
    "update:readme": "node scripts/update-readme.js",
    "generate:agents-md": "node scripts/generate-agents-md.js",
    "scorecard": "node scripts/gen-eval-scorecard.mjs",
    "scorecard:check": "node scripts/gen-eval-scorecard.mjs --check",
    "materialize": "node scripts/materialize-plugins.js",
    "materialize:dry": "node scripts/materialize-plugins.js --dry-run",
    "scaffold": "node scripts/scaffold-primitive.js",
    "sync": "node scripts/sync-content.js",
    "validate:fix": "node scripts/validate-consistency.js --fix",
    "build": "npm run validate:primitives && npm run generate:marketplace && npm run generate:website-data && npm run update:readme",
    "build:action": "npx @vercel/ncc build src/action-runtime.js -o dist --minify --no-source-map-register",
    "test:engine": "node engine/test.js",
    "manifests:check": "node scripts/solution-play-manifest-contract.mjs",
    "manifests:fix": "node scripts/solution-play-manifest-contract.mjs --fix",
    "test:manifest-contract": "node --test scripts/test-solution-play-manifest-contract.mjs",
    "contracts:inventory": "node scripts/solution-play-contract-inventory.mjs",
    "contracts:migration-preview": "node scripts/solution-play-evidence-v2-migration.mjs",
