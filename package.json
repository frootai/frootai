    "runtime:datasets": "node scripts/build-flagship-evaluation-datasets.mjs",
    "runtime:start": "node solution-plays/runtime/server.mjs",
    "runtime:test": "node --test solution-plays/runtime/test/*.test.mjs",
    "policy:check": "node scripts/solution-play-policy.mjs",
    "test:policy": "node --test scripts/test-solution-play-policy.mjs",
    "test:conformance": "node conformance/index.js",
    "release": "node scripts/release-channel.js",
    "release:dry": "node scripts/release-channel.js --dry-run",
    "release:mcp": "node scripts/release-channel.js mcp",
    "release:cli": "node scripts/release-channel.js cli",
    "release:ext": "node scripts/release-channel.js ext",
    "release:sdk": "node scripts/release-channel.js sdk",
    "release:pymcp": "node scripts/release-channel.js pymcp",
    "release:all": "node scripts/release-channel.js all",
    "release:all:minor": "node scripts/release-channel.js all minor",
    "prepare": "husky",
    "factory": "node scripts/factory/index.js",
    "factory:harvest": "node scripts/factory/harvest.js",
    "factory:catalog": "node scripts/factory/catalog.js",
    "factory:diff": "node scripts/factory/diff.js",
    "factory:transform": "node scripts/factory/transform.js",
    "factory:validate": "node scripts/factory/validate.js",
    "factory:website": "node scripts/factory/transform.js --channel website",
    "factory:status": "node scripts/factory/status.js",
    "factory:watch": "node scripts/factory/watch.js",
    "factory:ship": "node scripts/factory/ship.js",
    "factory:unify": "node scripts/factory/unify.js",
    "factory:adapt:sk": "node scripts/factory/adapters/semantic-kernel.js",
    "factory:adapt:langchain": "node scripts/factory/adapters/langchain.js",
    "factory:adapt:all": "node scripts/factory/adapters/semantic-kernel.js && node scripts/factory/adapters/langchain.js",
    "factory:docs": "node scripts/factory/adapters/docs.js",
    "lean:api": "node engine/lean-compiler-plus/server.mjs",
    "lean:api:test": "node --test engine/lean-compiler-plus/server.test.mjs",
    "factory:docs:learning": "node scripts/factory/adapters/docs.js --section=learning",
    "factory:docs:plays": "node scripts/factory/adapters/docs.js --section=solution-plays",
    "factory:docs:api": "node scripts/factory/adapters/docs.js --section=api-reference",
    "factory:repo-split": "node scripts/factory/repo-split.js",
    "factory:repo-split:classify": "node scripts/factory/repo-split.js --classify",
    "factory:repo-split:dry-run": "node scripts/factory/repo-split.js --dry-run",
    "factory:test": "node scripts/factory/test.js",
    "factory:search-quality": "node scripts/factory/golden-queries.js",
    "moonshot:test": "node engine/moonshot/index.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7",
    "yaml": "2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frootai/frootai"
  },
  "license": "MIT",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gpt-tokenizer": "^3.4.0",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  }
}
