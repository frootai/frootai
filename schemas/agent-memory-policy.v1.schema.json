{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frootai.dev/schemas/agent-memory-policy.v1.json",
  "title": "Agent Memory Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "applicability"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema_version": { "const": "1.0.0" },
    "applicability": { "enum": ["applicable", "not_applicable"] },
    "reason": { "type": "string", "minLength": 10 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "purpose", "scope", "retention", "encryption", "retrieval", "deletion", "evaluation"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 10 },
        "scope": { "enum": ["turn", "session", "user", "tenant", "organization"] },
        "retention": { "type": "object", "additionalProperties": false, "required": ["ttl_seconds", "legal_hold_supported"], "properties": { "ttl_seconds": { "type": "integer", "minimum": 0 }, "legal_hold_supported": { "type": "boolean" } } },
        "encryption": { "type": "object", "additionalProperties": false, "required": ["at_rest", "in_transit", "key_owner"], "properties": { "at_rest": { "const": true }, "in_transit": { "const": true }, "key_owner": { "type": "string", "minLength": 1 } } },
        "retrieval": { "type": "object", "additionalProperties": false, "required": ["strategy", "authorization"], "properties": { "strategy": { "enum": ["exact", "semantic", "hybrid"] }, "authorization": { "type": "string", "minLength": 1 }, "max_results": { "type": "integer", "minimum": 1 } } },
        "deletion": { "type": "object", "additionalProperties": false, "required": ["mechanism", "verification"], "properties": { "mechanism": { "type": "string", "minLength": 1 }, "verification": { "type": "string", "minLength": 1 } } },
        "evaluation": { "type": "object", "additionalProperties": false, "required": ["dataset", "metrics", "thresholds"], "properties": { "dataset": { "type": "string", "minLength": 1 }, "metrics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "thresholds": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number" } } } },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "redaction": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "applicability": { "const": "applicable" } } }, "then": { "properties": { "policy": {} }, "required": ["policy"] } },
    { "if": { "properties": { "applicability": { "const": "not_applicable" } } }, "then": { "properties": { "reason": {}, "policy": false }, "required": ["reason"] } }
  ]
}