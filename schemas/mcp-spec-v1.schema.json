{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frootai.dev/schemas/mcp-spec-v1.json",
  "title": "FAI MCP Attach Spec v1 (ExternalMcpSpec)",
  "description": "Canonical schema for a Tier-1 MCP attach spec under `frootai/orchard/registry/mcp-specs/<slug>.json`. Validates the spec library authored in Phase [X2] (azure, playwright, github, markitdown, context7, ms-learn). Mirrors the PURE contract in frootai-core/scripts/marketplace/crawler/lib/spec-fields.js.",
  "$comment": "License: CC0-1.0. Authored as part of Phase [X2.8] of the FAI MCP Marketplace + Trust masterplan. Doctrine #2 (publisher === trust.json key) + #5 (slug === tool_prefix, unique) + #6 (env_passthrough names-only).",

  "type": "object",
  "required": [
    "spec_version",
    "slug",
    "title",
    "publisher",
    "trust",
    "tool_prefix",
    "description",
    "transport",
    "version_pin",
    "env_vars",
    "auth",
    "sample_tools",
    "destructive_tools",
    "known_limitations"
  ],
  "additionalProperties": false,

  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "$comment": { "type": "string" },
    "_doc": {
      "type": "object",
      "description": "Field-level documentation. Present only in `_template.json`; ignored for real specs."
    },

    "spec_version": { "type": "string", "const": "1.0.0" },

    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "description": "Stable kebab-case identity === filename === tool_prefix === federation namespace prefix (doctrine #5)."
    },
    "title": { "type": "string", "minLength": 1 },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "description": "Lowercase GitHub org === a knownPublishers key in trust.json (doctrine #2)."
    },
    "trust": {
      "type": "string",
      "enum": ["first-party-ms", "verified-publisher", "community", "untrusted"]
    },
    "tool_prefix": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "description": { "type": "string", "minLength": 1 },

    "transport": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["stdio-subprocess", "http-sse"] },
        "command": { "type": ["string", "null"] },
        "args": { "type": "array", "items": { "type": "string" } },
        "url": { "type": ["string", "null"] },
        "env_passthrough": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "description": "Env-var NAME only — no `=value` (doctrine #6)."
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "stdio-subprocess" } } },
          "then": {
            "required": ["command", "args"],
            "properties": { "command": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "http-sse" } } },
          "then": {
            "required": ["url"],
            "properties": { "url": { "type": "string", "format": "uri", "minLength": 1 } }
          }
        }
      ]
    },

    "version_pin": {
      "type": "object",
      "required": ["version_range", "tested_version"],
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": ["string", "null"],
          "description": "Upstream package id; null for hosted endpoints (e.g. ms-learn)."
        },
        "version_range": {
          "type": "string",
          "minLength": 1,
          "description": "Supported semver range, or the literal `hosted` for remote endpoints with no package."
        },
        "tested_version": { "type": "string", "minLength": 1 }
      }
    },

    "env_vars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "required", "auth_mode", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "required": { "type": "boolean" },
          "auth_mode": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },

    "auth": {
      "type": "object",
      "required": ["recipe", "modes"],
      "additionalProperties": false,
      "properties": {
        "recipe": { "type": "string", "minLength": 1 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },

    "sample_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },

    "destructive_tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },

    "known_limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },

    "client_install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude_desktop": { "type": "string" },
        "cursor": { "type": "string" },
        "vscode": { "type": "string" }
      }
    },

    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "drift_threshold_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },

    "last_reviewed": { "type": "string", "format": "date" },
    "reviewer": { "type": "string", "minLength": 1 }
  }
}
