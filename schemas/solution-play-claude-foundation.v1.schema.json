{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frootai.dev/schemas/solution-play-claude-foundation.v1.json",
  "title": "Solution Play Claude Foundation Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin", "contracts", "skills", "agent", "hook_policy"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema_version": { "const": "1.0.0" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display_name", "description", "author", "license", "repository", "homepage", "keywords", "default_enabled"],
      "properties": {
        "name": { "const": "frootai-foundation" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 20, "maxLength": 500 },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "license": { "const": "MIT" },
        "repository": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" },
        "keywords": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "default_enabled": { "const": false }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9.-]+\\.schema\\.json$" },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "purpose", "procedure"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "description": { "type": "string", "minLength": 20, "maxLength": 500 },
          "purpose": { "type": "string", "minLength": 20 },
          "procedure": { "$ref": "#/$defs/nonEmptyStrings" },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "title", "content"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9-]+\\.md$" },
              "title": { "type": "string", "minLength": 1 },
              "content": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "tools", "model", "max_turns", "skills", "instructions"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 20, "maxLength": 500 },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["Read", "Grep", "Glob"] },
          "uniqueItems": true
        },
        "model": { "const": "inherit" },
        "max_turns": { "type": "integer", "minimum": 1, "maximum": 25 },
        "skills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "instructions": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "hook_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_input_bytes", "timeout_seconds", "protected_paths", "blocked_commands"],
      "properties": {
        "maximum_input_bytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 15 },
        "protected_paths": { "$ref": "#/$defs/nonEmptyStrings" },
        "blocked_commands": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}