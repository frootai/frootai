{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frootai.dev/schemas/solution-play-claude-plugin.v1.json",
  "title": "Solution Play Claude Plugin Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "play", "title", "description", "plugin", "agents", "skills", "hook_policy", "mcp", "assets", "project_guidance"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema_version": { "const": "1.1.0" },
    "play": { "type": "string", "pattern": "^[0-9]{2,3}-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 20, "maxLength": 500 },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display_name", "author", "license", "repository", "homepage", "keywords", "default_enabled", "dependency"],
      "properties": {
        "name": { "type": "string", "pattern": "^frootai-[0-9]{2,3}-[a-z0-9-]+$", "maxLength": 64 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "license": { "const": "MIT" },
        "repository": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" },
        "keywords": { "type": "array", "minItems": 3, "maxItems": 12, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "default_enabled": { "const": false },
        "dependency": { "const": "frootai-foundation" }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "authority", "tools", "model", "max_turns", "skills", "instructions"],
        "properties": {
          "name": { "$ref": "#/$defs/id" },
          "description": { "type": "string", "minLength": 20, "maxLength": 500 },
          "authority": { "enum": ["read-only", "project-write"] },
          "tools": { "type": "array", "minItems": 1, "items": { "enum": ["Read", "Grep", "Glob", "Edit", "Bash"] }, "uniqueItems": true },
          "model": { "const": "inherit" },
          "max_turns": { "type": "integer", "minimum": 1, "maximum": 30 },
          "skills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "instructions": { "$ref": "#/$defs/nonEmptyStrings" }
        },
        "allOf": [
          {
            "if": { "properties": { "authority": { "const": "read-only" } }, "required": ["authority"] },
            "then": { "properties": { "tools": { "type": "array", "items": { "enum": ["Read", "Grep", "Glob"] } } } }
          }
        ]
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "authority", "purpose", "procedure", "allowed_tools"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "description": { "type": "string", "minLength": 20, "maxLength": 500 },
          "authority": { "enum": ["read-only", "project-write"] },
          "purpose": { "type": "string", "minLength": 20 },
          "procedure": { "$ref": "#/$defs/nonEmptyStrings" },
          "allowed_tools": { "type": "array", "minItems": 1, "items": { "enum": ["Read", "Grep", "Glob", "Edit", "Bash"] }, "uniqueItems": true }
        },
        "allOf": [
          {
            "if": { "properties": { "authority": { "const": "read-only" } }, "required": ["authority"] },
            "then": { "properties": { "allowed_tools": { "type": "array", "items": { "enum": ["Read", "Grep", "Glob"] } } } }
          }
        ]
      }
    },
    "hook_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_input_bytes", "timeout_seconds", "protected_paths", "blocked_commands", "allowed_commands"],
      "properties": {
        "maximum_input_bytes": { "type": "integer", "minimum": 1024, "maximum": 65536 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 15 },
        "protected_paths": { "$ref": "#/$defs/nonEmptyStrings" },
        "blocked_commands": { "$ref": "#/$defs/nonEmptyStrings" },
        "allowed_commands": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_id", "protocol_version", "instructions", "tool"],
      "properties": {
        "server_id": { "const": "play-context" },
        "protocol_version": { "const": "2025-11-25" },
        "instructions": { "type": "string", "minLength": 20, "maxLength": 500 },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "description", "maximum_result_chars"],
          "properties": {
            "name": { "const": "get_play_context" },
            "description": { "type": "string", "minLength": 20, "maxLength": 500 },
            "maximum_result_chars": { "type": "integer", "minimum": 256, "maximum": 8192 }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "content"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" },
          "content": { "type": "object" }
        }
      }
    },
    "project_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_total_bytes", "claude_md", "rules", "subagents", "worktree"],
      "properties": {
        "maximum_total_bytes": { "type": "integer", "minimum": 4096, "maximum": 65536 },
        "claude_md": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum_lines", "purpose", "commands", "invariants", "workflow"],
          "properties": {
            "maximum_lines": { "type": "integer", "minimum": 10, "maximum": 200 },
            "purpose": { "type": "string", "minLength": 20, "maxLength": 500 },
            "commands": { "$ref": "#/$defs/nonEmptyStrings" },
            "invariants": { "$ref": "#/$defs/nonEmptyStrings" },
            "workflow": { "$ref": "#/$defs/nonEmptyStrings" }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "paths", "instructions"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string", "minLength": 1, "maxLength": 100 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": { "$ref": "#/$defs/projectGlob" },
                "uniqueItems": true
              },
              "instructions": { "$ref": "#/$defs/nonEmptyStrings" }
            }
          }
        },
        "subagents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_agent", "name", "permission_mode", "isolation", "memory"],
            "properties": {
              "source_agent": { "$ref": "#/$defs/id" },
              "name": { "$ref": "#/$defs/id" },
              "permission_mode": { "enum": ["default", "plan", "dontAsk"] },
              "isolation": { "enum": ["none", "worktree"] },
              "memory": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["enabled", "reason"],
                    "properties": {
                      "enabled": { "const": false },
                      "reason": { "type": "string", "minLength": 20, "maxLength": 500 }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["enabled", "scope", "owner", "purpose", "retention", "deletion", "evaluation"],
                    "properties": {
                      "enabled": { "const": true },
                      "scope": { "const": "local" },
                      "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
                      "purpose": { "type": "string", "minLength": 20, "maxLength": 500 },
                      "retention": { "type": "string", "minLength": 20, "maxLength": 500 },
                      "deletion": { "type": "string", "minLength": 20, "maxLength": 500 },
                      "evaluation": { "type": "string", "minLength": 20, "maxLength": 500 }
                    }
                  }
                ]
              }
            }
          }
        },
        "worktree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_ref", "background_isolation", "sparse_paths", "symlink_directories", "instructions"],
          "properties": {
            "base_ref": { "const": "fresh" },
            "background_isolation": { "const": "worktree" },
            "sparse_paths": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/projectPath" },
              "uniqueItems": true
            },
            "symlink_directories": {
              "type": "array",
              "maxItems": 8,
              "items": { "$ref": "#/$defs/projectPath" },
              "uniqueItems": true
            },
            "instructions": { "$ref": "#/$defs/nonEmptyStrings" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "projectGlob": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000-\\u001f]+$" },
    "projectPath": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[a-zA-Z0-9._/-]+$" }
  }
}