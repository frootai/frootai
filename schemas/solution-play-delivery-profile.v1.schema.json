{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frootai.dev/schemas/solution-play-delivery-profile.v1.json",
  "title": "Solution Play Delivery Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "play", "applicability"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema_version": { "const": "1.2.0" },
    "play": { "type": "string", "pattern": "^[0-9]{2,3}-[a-z0-9-]+$" },
    "applicability": { "enum": ["applicable", "not_applicable"] },
    "reason": { "type": "string", "minLength": 20 },
    "vertical_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "topology", "entrypoint", "layout", "infrastructure", "commands", "environments"],
      "properties": {
        "root": { "$ref": "#/$defs/path" },
        "topology": { "$ref": "#/$defs/topology" },
        "entrypoint": { "$ref": "#/$defs/path" },
        "layout": { "$ref": "#/$defs/layout" },
        "infrastructure": { "$ref": "#/$defs/applicability" },
        "commands": { "$ref": "#/$defs/commands" },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["offline", "local", "ci", "development", "staging", "production"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "applicability": { "const": "applicable" } }, "required": ["applicability"] },
      "then": { "required": ["vertical_slice"], "properties": { "reason": false, "vertical_slice": {} } }
    },
    {
      "if": { "properties": { "applicability": { "const": "not_applicable" } }, "required": ["applicability"] },
      "then": { "required": ["reason"], "properties": { "reason": {}, "vertical_slice": false } }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.?(/|$)|.*\\.\\.).+$"
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rationale"],
      "properties": {
        "kind": { "enum": ["deterministic-function", "workflow", "single-agent", "multi-agent"] },
        "rationale": { "type": "string", "minLength": 20 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "tests", "evals", "ops", "observability", "evidence"],
      "properties": {
        "app": { "$ref": "#/$defs/path" },
        "tests": { "$ref": "#/$defs/path" },
        "evals": { "$ref": "#/$defs/path" },
        "ops": { "$ref": "#/$defs/path" },
        "observability": { "$ref": "#/$defs/path" },
        "evidence": { "$ref": "#/$defs/path" },
        "developer_agents": { "$ref": "#/$defs/path" }
      }
    },
    "applicability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "path"],
          "properties": {
            "applicability": { "const": "applicable" },
            "path": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "reason"],
          "properties": {
            "applicability": { "const": "not_applicable" },
            "reason": { "type": "string", "minLength": 20 }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "working_directory", "timeout_seconds", "mode", "stdin", "network", "mutation", "receipt"],
      "properties": {
        "executable": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|.*\\.\\.)[A-Za-z0-9._/-]+$" },
        "arguments": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 1024, "pattern": "^[^\\r\\n]*$" }
        },
        "working_directory": { "$ref": "#/$defs/path" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "mode": { "enum": ["finite", "service"] },
        "stdin": { "const": "closed" },
        "network": { "enum": ["none", "loopback", "restricted", "required"] },
        "mutation": { "enum": ["none", "workspace", "external"] },
        "receipt": { "$ref": "#/$defs/path" },
        "idempotent": { "type": "boolean" }
      }
    },
    "cleanup": {
      "allOf": [
        { "$ref": "#/$defs/command" },
        {
          "type": "object",
          "required": ["idempotent"],
          "properties": { "idempotent": { "const": true } }
        }
      ]
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "start", "test", "evaluate", "security", "cleanup"],
      "properties": {
        "setup": { "$ref": "#/$defs/command" },
        "start": { "$ref": "#/$defs/command" },
        "stop": { "$ref": "#/$defs/command" },
        "test": { "$ref": "#/$defs/command" },
        "evaluate": { "$ref": "#/$defs/command" },
        "security": { "$ref": "#/$defs/command" },
        "deploy": { "$ref": "#/$defs/command" },
        "smoke": { "$ref": "#/$defs/command" },
        "rollback": { "$ref": "#/$defs/command" },
        "cleanup": { "$ref": "#/$defs/cleanup" }
      },
      "dependentRequired": {
        "deploy": ["smoke", "rollback"],
        "smoke": ["deploy"],
        "rollback": ["deploy"]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "start": { "type": "object", "properties": { "mode": { "const": "service" } }, "required": ["mode"] }
            },
            "required": ["start"]
          },
          "then": { "required": ["stop"], "properties": { "stop": {} } }
        }
      ]
    }
  }
}