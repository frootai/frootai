{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frootai.dev/schemas/solution-play-delivery-profile.v1.json",
  "title": "Solution Play Delivery Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "play", "applicability"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema_version": { "const": "1.0.0" },
    "play": { "type": "string", "pattern": "^[0-9]{2,3}-[a-z0-9-]+$" },
    "applicability": { "enum": ["applicable", "not_applicable"] },
    "reason": { "type": "string", "minLength": 10 },
    "vertical_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "commands", "environments"],
      "properties": {
        "entrypoint": { "$ref": "#/$defs/path" },
        "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setup", "start", "test", "cleanup"],
          "properties": {
            "setup": { "type": "string", "minLength": 1 },
            "start": { "type": "string", "minLength": 1 },
            "test": { "type": "string", "minLength": 1 },
            "deploy": { "type": "string", "minLength": 1 },
            "rollback": { "type": "string", "minLength": 1 },
            "cleanup": { "type": "string", "minLength": 1 }
          }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["offline", "local", "ci", "development", "staging", "production"] }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "applicability": { "const": "applicable" } } }, "then": { "properties": { "vertical_slice": {} }, "required": ["vertical_slice"] } },
    { "if": { "properties": { "applicability": { "const": "not_applicable" } } }, "then": { "properties": { "reason": {}, "vertical_slice": false }, "required": ["reason"] } }
  ],
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+$" }
  }
}