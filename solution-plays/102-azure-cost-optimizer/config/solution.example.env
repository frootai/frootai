# Copy values into your protected process environment. Do not rename this file to .env and commit it.
ACO_SUBSCRIPTION_ID=<subscription-id>
ACO_TENANT_ID=<tenant-id>
ACO_LOCATION=eastus2
ACO_PREFIX=<team>-aco-lab
ACO_RESOURCE_GROUP=rg-<team>-aco-lab-eus2
ACO_OWNER=<owner-alias>
ACO_EXPIRES_ON=2026-10-01

# Optional organization-approved policy metadata. Leave empty unless explicitly approved.
ACO_SECURITY_CONTROL=

# Provider: none | foundry | azure-openai
ACI_AI_PROVIDER=none
AZURE_AI_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<deployment-name>
AZURE_OPENAI_ENDPOINT=https://<azure-openai-account>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=<deployment-name>
AZURE_OPENAI_AUTH_MODE=identity

# Hosted application values are generated under .solution and are never committed.
ACO_APPLICATION_URL=https://<container-app-fqdn>
