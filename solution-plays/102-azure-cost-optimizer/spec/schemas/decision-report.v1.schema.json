{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://frootai.dev/schemas/102/decision-report.v1.json",
    "title": "Azure Cost Intelligence Decision Report v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "reportId",
        "tenantAlias",
        "scopeAlias",
        "requestedPeriod",
        "actualPeriod",
        "financialBasis",
        "currency",
        "collectedAt",
        "complete",
        "totalCost",
        "opportunities",
        "dataHealth",
        "evidenceLedger",
        "limitations"
    ],
    "properties": {
        "schemaVersion": {
            "const": "1.0.0"
        },
        "reportId": {
            "type": "string",
            "pattern": "^rpt_[a-f0-9]{32,64}$"
        },
        "tenantAlias": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "scopeAlias": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "requestedPeriod": {
            "$ref": "#/$defs/period"
        },
        "actualPeriod": {
            "$ref": "#/$defs/period"
        },
        "financialBasis": {
            "enum": [
                "billed",
                "effective"
            ]
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "collectedAt": {
            "type": "string",
            "format": "date-time"
        },
        "complete": {
            "type": "boolean"
        },
        "totalCost": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "totalEstimatedOpportunity": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "services": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/allocation"
            }
        },
        "opportunities": {
            "type": "array",
            "items": {
                "type": "object"
            }
        },
        "advisorFindings": {
            "type": "array",
            "items": {
                "type": "object"
            }
        },
        "dataHealth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "sourceReceiptHashes",
                "excludedRows"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "fresh",
                        "stale",
                        "degraded",
                        "partial",
                        "unavailable"
                    ]
                },
                "sourceReceiptHashes": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                    },
                    "uniqueItems": true
                },
                "excludedRows": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "evidenceLedger": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/evidence"
            }
        },
        "limitations": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 500
            }
        }
    },
    "$defs": {
        "period": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start",
                "end"
            ],
            "properties": {
                "start": {
                    "type": "string",
                    "format": "date"
                },
                "end": {
                    "type": "string",
                    "format": "date"
                }
            }
        },
        "allocation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "amount"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                },
                "amount": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                }
            }
        },
        "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "evidenceId",
                "source",
                "claimType",
                "contentSha256"
            ],
            "properties": {
                "evidenceId": {
                    "type": "string",
                    "pattern": "^ev_[a-f0-9]{16,64}$"
                },
                "source": {
                    "type": "string",
                    "minLength": 1
                },
                "claimType": {
                    "type": "string",
                    "minLength": 1
                },
                "contentSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        }
    }
}