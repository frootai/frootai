{
    "schema_version": "1.0.0",
    "agent": "aco-supervisor",
    "limits": {
        "maximum_model_calls": 6,
        "maximum_tool_calls": 6,
        "maximum_output_tokens": 32768,
        "maximum_result_characters": 16384,
        "reauthorize_each_call": true
    },
    "tools": [
        {
            "name": "get_cost_summary",
            "description": "Read the authorized report summary, period, basis, currency, freshness, and completeness before detailed analysis.",
            "readOnly": true,
            "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "scopeAlias",
                    "reportId"
                ],
                "properties": {
                    "scopeAlias": {
                        "$ref": "#/$defs/scopeAlias"
                    },
                    "reportId": {
                        "$ref": "#/$defs/reportId"
                    }
                }
            },
            "outputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "periodLabel",
                    "totalCost",
                    "currency",
                    "financialBasis",
                    "requestedPeriod",
                    "actualPeriod",
                    "collectedAt",
                    "complete",
                    "status",
                    "evidenceIds"
                ],
                "properties": {
                    "periodLabel": { "type": "string" },
                    "totalCost": { "$ref": "#/$defs/money" },
                    "currency": { "$ref": "#/$defs/currency" },
                    "financialBasis": { "$ref": "#/$defs/financialBasis" },
                    "requestedPeriod": { "$ref": "#/$defs/period" },
                    "actualPeriod": { "$ref": "#/$defs/period" },
                    "collectedAt": { "type": "string", "format": "date-time" },
                    "complete": { "type": "boolean" },
                    "status": { "enum": ["fresh", "stale", "degraded", "partial"] },
                    "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
                }
            }
        },
        {
            "name": "get_cost_breakdown",
            "description": "Read a bounded authorized service, resource group, or daily cost allocation from the validated report.",
            "readOnly": true,
            "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "scopeAlias",
                    "reportId",
                    "dimension"
                ],
                "properties": {
                    "scopeAlias": {
                        "$ref": "#/$defs/scopeAlias"
                    },
                    "reportId": {
                        "$ref": "#/$defs/reportId"
                    },
                    "dimension": {
                        "enum": [
                            "service",
                            "resourceGroup",
                            "daily",
                            "all"
                        ]
                    },
                    "limit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 90,
                        "default": 10
                    }
                }
            },
            "outputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "items",
                    "currency",
                    "financialBasis",
                    "complete",
                    "evidenceIds"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "oneOf": [
                                {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": ["name", "amount"],
                                    "properties": { "name": { "type": "string" }, "amount": { "type": "number" } }
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": ["date", "amount"],
                                    "properties": { "date": { "type": "string" }, "amount": { "type": "number" } }
                                }
                            ]
                        }
                    },
                    "currency": { "$ref": "#/$defs/currency" },
                    "financialBasis": { "$ref": "#/$defs/financialBasis" },
                    "complete": { "type": "boolean" },
                    "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
                }
            }
        },
        {
            "name": "get_opportunities",
            "description": "Read bounded evidence-backed opportunities with observed, estimated, approved, and realized values kept separate.",
            "readOnly": true,
            "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "scopeAlias",
                    "reportId"
                ],
                "properties": {
                    "scopeAlias": {
                        "$ref": "#/$defs/scopeAlias"
                    },
                    "reportId": {
                        "$ref": "#/$defs/reportId"
                    },
                    "category": {
                        "enum": [null, "advisor", "idle", "rightsizing", "storage", "monitor", "schedule", "commitment", "governance"]
                    },
                    "limit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20,
                        "default": 10
                    }
                }
            },
            "outputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "items",
                    "complete",
                    "evidenceIds"
                ],
                "properties": {
                    "items": { "type": "array", "items": { "$ref": "./schemas/opportunity.v1.schema.json" } },
                    "complete": { "type": "boolean" },
                    "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
                }
            }
        },
        {
            "name": "get_advisor_findings",
            "description": "Read normalized Advisor Cost findings without treating recommendations as approvals or realized savings.",
            "readOnly": true,
            "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "scopeAlias",
                    "reportId"
                ],
                "properties": {
                    "scopeAlias": {
                        "$ref": "#/$defs/scopeAlias"
                    },
                    "reportId": {
                        "$ref": "#/$defs/reportId"
                    },
                    "limit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20,
                        "default": 10
                    }
                }
            },
            "outputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "items",
                    "complete",
                    "evidenceIds"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["title", "evidenceId", "estimatedAnnualSavings", "savingsCurrency"],
                            "properties": {
                                "title": { "type": "string" },
                                "evidenceId": { "$ref": "#/$defs/evidenceId" },
                                "estimatedAnnualSavings": { "type": ["number", "null"] },
                                "savingsCurrency": { "anyOf": [{ "$ref": "#/$defs/currency" }, { "type": "null" }] }
                            }
                        }
                    },
                    "complete": { "type": "boolean" },
                    "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
                }
            }
        },
        {
            "name": "get_data_health",
            "description": "Read source freshness, completeness, exclusions, throttle state, and retry timing for the authorized report.",
            "readOnly": true,
            "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "scopeAlias",
                    "reportId"
                ],
                "properties": {
                    "scopeAlias": {
                        "$ref": "#/$defs/scopeAlias"
                    },
                    "reportId": {
                        "$ref": "#/$defs/reportId"
                    }
                }
            },
            "outputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "status",
                    "sources",
                    "excludedRows",
                    "resourceCount",
                    "failedSource",
                    "retryAt",
                    "costSourceStatus",
                    "requestedPeriod",
                    "complete",
                    "evidenceIds"
                ],
                "properties": {
                    "status": { "type": "string" },
                    "sources": { "type": "array", "items": { "$ref": "./schemas/source-receipt.v1.schema.json" } },
                    "excludedRows": { "type": "integer", "minimum": 0 },
                    "resourceCount": { "type": "integer", "minimum": 0 },
                    "failedSource": { "type": ["string", "null"] },
                    "retryAt": { "type": ["string", "null"], "format": "date-time" },
                    "costSourceStatus": { "type": "string" },
                    "requestedPeriod": { "$ref": "#/$defs/period" },
                    "complete": { "type": "boolean" },
                    "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
                }
            }
        },
        {
            "name": "get_evidence",
            "description": "Read a bounded minimized evidence record already referenced by the authorized report.",
            "readOnly": true,
            "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "scopeAlias",
                    "reportId",
                    "evidenceId"
                ],
                "properties": {
                    "scopeAlias": {
                        "$ref": "#/$defs/scopeAlias"
                    },
                    "reportId": {
                        "$ref": "#/$defs/reportId"
                    },
                    "evidenceId": {
                        "$ref": "#/$defs/evidenceId"
                    }
                }
            },
            "outputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "evidenceId",
                    "source",
                    "claimType",
                    "value",
                    "contentSha256"
                ],
                "properties": {
                    "evidenceId": { "$ref": "#/$defs/evidenceId" },
                    "source": { "type": "string" },
                    "claimType": { "type": "string" },
                    "value": { "type": "object" },
                    "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
            }
        },
        {
            "name": "create_report",
            "description": "Create an immutable private report artifact from the caller's already-authorized validated revision; this does not modify Azure resources.",
            "readOnly": true,
            "destructive": false,
            "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "scopeAlias",
                    "revisionId",
                    "formats"
                ],
                "properties": {
                    "scopeAlias": {
                        "$ref": "#/$defs/scopeAlias"
                    },
                    "revisionId": {
                        "type": "string",
                        "pattern": "^rev_[a-f0-9]{32,64}$"
                    },
                    "formats": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "enum": [
                                "json",
                                "csv",
                                "html",
                                "focus",
                                "pdf"
                            ]
                        }
                    }
                }
            },
            "outputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "reportId",
                    "formats",
                    "ownerBound",
                    "evidenceIds"
                ],
                "properties": {
                    "reportId": { "$ref": "#/$defs/reportId" },
                    "formats": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["format", "url"],
                            "properties": {
                                "format": { "enum": ["json", "csv", "html", "focus", "pdf"] },
                                "url": { "type": "string", "pattern": "^/api/v1/reports/" }
                            }
                        }
                    },
                    "ownerBound": { "const": true },
                    "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
                }
            }
        },
        {
            "name": "get_optimization_guidance",
            "description": "Read published Microsoft Well-Architected Framework cost optimization checklist items and FinOps Framework practices that match a topic or Azure service. This returns guidance text only, never customer cost amounts or savings estimates.",
            "readOnly": true,
            "inputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                    "topic": {
                        "type": ["string", "null"],
                        "maxLength": 64
                    },
                    "service": {
                        "type": ["string", "null"],
                        "maxLength": 64
                    },
                    "limit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 12,
                        "default": 6
                    }
                }
            },
            "outputSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "guidanceOnly",
                    "note",
                    "wellArchitected",
                    "finOps",
                    "sources"
                ],
                "properties": {
                    "guidanceOnly": { "const": true },
                    "note": { "type": "string" },
                    "wellArchitected": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["code", "title", "recommendation"],
                            "properties": {
                                "code": { "type": "string", "pattern": "^CO:[0-9]{2}$" },
                                "title": { "type": "string" },
                                "recommendation": { "type": "string" }
                            }
                        }
                    },
                    "finOps": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["phase", "title", "practice"],
                            "properties": {
                                "phase": { "enum": ["inform", "optimize", "operate"] },
                                "title": { "type": "string" },
                                "practice": { "type": "string" }
                            }
                        }
                    },
                    "sources": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["title", "url"],
                            "properties": {
                                "title": { "type": "string" },
                                "url": { "type": "string", "format": "uri" }
                            }
                        }
                    }
                }
            }
        }
    ],
    "$defs": {
        "scopeAlias": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "reportId": {
            "type": "string",
            "pattern": "^rpt_[a-f0-9]{32,64}$"
        },
        "evidenceId": {
            "type": "string",
            "pattern": "^ev_[a-f0-9]{16,64}$"
        },
        "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/evidenceId" }
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "financialBasis": {
            "enum": ["billed", "effective"]
        },
        "period": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
                "start": { "type": "string" },
                "end": { "type": "string" }
            }
        },
        "money": {
            "type": "object",
            "additionalProperties": false,
            "required": ["amount", "currency"],
            "properties": {
                "amount": { "type": "number" },
                "currency": { "$ref": "#/$defs/currency" }
            }
        }
    }
}