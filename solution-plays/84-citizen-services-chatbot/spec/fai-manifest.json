{
  "play": "84-citizen-services-chatbot",
  "version": "1.0.0",
  "description": "Multi-language municipal services AI assistant with form filling guidance, appointment scheduling, permit status tracking, FAQ resolution, and human agent escalation for complex cases.",
  "context": {
    "knowledge": [
      "R2-RAG-Architecture",
      "O2-AI-Agents",
      "T2-Responsible-AI"
    ],
    "waf": [
      "responsible-ai",
      "reliability",
      "security",
      "performance-efficiency"
    ]
  },
  "primitives": {
    "agents": [
      ".github/agents/builder.agent.md",
      ".github/agents/reviewer.agent.md",
      ".github/agents/tuner.agent.md"
    ],
    "instructions": [
      ".github/instructions/citizen-services-chatbot-patterns.instructions.md"
    ],
    "skills": [
      ".github/skills/deploy-citizen-services-chatbot/",
      ".github/skills/evaluate-citizen-services-chatbot/",
      ".github/skills/tune-citizen-services-chatbot/"
    ],
    "hooks": [
      "../../hooks/fai-secrets-scanner/",
      "../../hooks/fai-tool-guardian/",
      "../../hooks/fai-governance-audit/"
    ]
  },
  "infrastructure": {
    "services": [
      "Azure OpenAI",
      "Azure AI Translator",
      "Azure Communication Services",
      "Azure AI Search",
      "Azure Cosmos DB"
    ],
    "template": "infra/main.bicep",
    "parameters": "infra/parameters.json"
  },
  "toolkit": {
    "devkit": ".github/",
    "tunekit": "config/",
    "speckit": "spec/"
  },
  "guardrails": {
    "groundedness": 0.85,
    "coherence": 0.8,
    "relevance": 0.8,
    "safety": 0,
    "costPerQuery": 0.05
  }
}
