{
  "play": "98-agent-evaluation-platform",
  "version": "1.0.0",
  "description": "Automated evaluation suite for any AI agent — standardized benchmarks, regression testing, A/B experimentation, human preference scoring, and leaderboard ranking. Evaluates agents across quality, safety, speed, cost, and user satisfaction dimensions.",
  "context": {
    "knowledge": [
      "T3-Production-Patterns",
      "T2-Responsible-AI",
      "O2-AI-Agents"
    ],
    "waf": [
      "responsible-ai",
      "reliability",
      "operational-excellence",
      "cost-optimization"
    ]
  },
  "primitives": {
    "agents": [
      ".github/agents/builder.agent.md",
      ".github/agents/reviewer.agent.md",
      ".github/agents/tuner.agent.md"
    ],
    "instructions": [
      ".github/instructions/agent-evaluation-platform-patterns.instructions.md"
    ],
    "skills": [
      ".github/skills/deploy-agent-evaluation-platform/",
      ".github/skills/evaluate-agent-evaluation-platform/",
      ".github/skills/tune-agent-evaluation-platform/"
    ],
    "hooks": [
      "../../hooks/fai-secrets-scanner/",
      "../../hooks/fai-tool-guardian/",
      "../../hooks/fai-governance-audit/"
    ]
  },
  "infrastructure": {
    "services": [
      "Azure OpenAI",
      "Azure Container Apps",
      "Azure Cosmos DB",
      "Azure Machine Learning",
      "Azure Functions"
    ],
    "template": "infra/main.bicep",
    "parameters": "infra/parameters.json"
  },
  "toolkit": {
    "devkit": ".github/",
    "tunekit": "config/",
    "speckit": "spec/"
  },
  "guardrails": {
    "groundedness": 0.85,
    "coherence": 0.85,
    "relevance": 0.85,
    "safety": 0,
    "costPerQuery": 0.08
  }
}
