  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run package",
    "compile": "npm run check-types && npm run build:webview && node esbuild.config.mjs",
    "check-types": "tsc --noEmit",
    "build:webview": "cd webview-ui && npm run build:win",
    "watch": "node esbuild.config.mjs --watch",
    "package": "npm run check-types && node esbuild.config.mjs --production",
    "lint": "eslint src/",
    "test": "tsx src/test/extension.test.ts && tsx src/test/tokenops.test.ts && tsx src/test/play-detail-workflow.test.ts && tsx src/test/account-agent-platform.test.ts && tsx src/test/repository-intelligence.test.ts && tsx src/test/accelerator-assets.test.ts",
    "test:federation": "node src/test/federation/command-registration.test.js && node src/test/federation/settings-env-mapping.test.js && node src/test/federation/tree-provider-data-shape.test.js && node src/test/federation/webview-message-handlers.test.js",
    "test:webview": "npm --prefix webview-ui test",
    "test:play-detail:live": "tsx scripts/smoke-play-detail-live.mts",
    "vsce:package": "vsce package",
    "vsce:publish": "vsce publish"
  },
  "dependencies": {
    "js-tiktoken": "1.0.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
