    "configuration": {
      "title": "FrootAI",
      "properties": {
        "frootai.mcpServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the FrootAI MCP server (index.js). Leave empty to use npx frootai-mcp."
        },
        "frootai.solutionPlaysPath": {
          "type": "string",
          "default": "",
          "description": "Path to the solution-plays directory. Leave empty for auto-detect."
        },
        "frootai.mcpAutoRegister": {
          "type": "boolean",
          "default": true,
          "description": "Automatically register the FrootAI MCP server so it appears in VS Code's @mcp gallery and is ready to use in Copilot Agent mode without manual configuration."
        },
        "frootai.mcpTransport": {
          "type": "string",
          "default": "stdio",
          "enum": [
            "stdio",
            "http"
          ],
          "enumDescriptions": [
            "Run MCP server as a local process (recommended for most users)",
            "Connect to a remote MCP server over HTTP (requires a hosted endpoint)"
          ],
          "description": "Transport protocol for the FrootAI MCP server."
        },
        "frootai.mcpHttpUrl": {
          "type": "string",
          "default": "https://mcp.frootai.dev/mcp",
          "description": "URL of the remote FrootAI MCP server (only used when mcpTransport is 'http')."
        },
        "frootai.orchard.mcpServer.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the FrootAI Orchard MCP server when the extension activates. When enabled, other VS Code extensions can discover and call orchard.search / .show / .install_command / .find_play / .list_pollinations via the discovery file at ~/.frootai/vscode-mcp-endpoint.json."
        },
        "frootai.orchard.mcpServer.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Explicit port for the FrootAI Orchard MCP server. Default 0 picks a free port (recommended — the actual port is written to the discovery file)."
        },
        "frootai.federation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for the M5 MCP Federation surface in this extension. When false, the extension's federation commands are inert and the spawned `frootai-mcp` subprocess receives FROOTAI_FEDERATION=off (total disable path)."
        },
        "frootai.federation.preAttach": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "description": "Area names to eagerly attach when the federation kernel boots. Each entry must match `[a-zA-Z0-9_-]+` (no dots, no spaces). Mapped to the FROOTAI_PREATTACH env var (comma-separated) at M5.14."
        },
        "frootai.federation.trustFile": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the operator trust override file. Leave empty to use the default `~/.frootai/trust.json` (XDG-aware). Mapped to FROOTAI_TRUST_FILE at M5.15."
        },
        "frootai.federation.idleDisconnectMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 1440,
          "description": "Minutes of zero MCP traffic before the kernel disconnects an attached area. Default 10. Mapped to FROOTAI_IDLE_DISCONNECT_MIN at M5.15."
        },
        "frootai.federation.autoAttachFromPlayManifest": {
          "type": "boolean",
          "default": true,
          "description": "When an Orchard Play is opened with `mcp_scope.attached` in its manifest, prompt the operator to attach the required federated areas. M5.18 implements the notification."
        },
        "frootai.federation.lean": {
          "type": "boolean",
          "default": false,
          "description": "⚡ Lean federation (low-calorie). Losslessly byte-compact federated tool descriptions (strip whitespace + routing ceremony) so an attached area's tool list loads with fewer tokens — same capability, no imperative/parameter altered. Maps to FROOTAI_LEAN_FEDERATION=1 for the spawned kernel."
        },
        "frootai.tokenOps.repository": {
          "type": "string",
          "default": "",
          "description": "Repository or chargeback key attached to imported TokenOps observations. Defaults to the workspace folder."
        },
        "frootai.tokenOps.defaultModel": {
          "type": "string",
          "default": "openai:gpt-5",
          "description": "Default TokenOps model registry ID."
        },
        "frootai.tokenOps.modelCatalogOverrides": {
          "type": "array",
          "default": [],
          "description": "Administrator model definitions and sourced pricing overrides. Prices require priceSource and priceAsOf provenance.",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "provider": { "type": "string", "enum": ["openai", "azure-openai", "anthropic", "google", "github-copilot", "custom"] },
              "displayName": { "type": "string" },
              "encoding": { "type": ["string", "null"], "enum": ["o200k_base", "cl100k_base", null] },
              "contextWindow": { "type": ["number", "null"], "minimum": 1 },
              "inputPerMillion": { "type": ["number", "null"], "minimum": 0 },
              "outputPerMillion": { "type": ["number", "null"], "minimum": 0 },
              "priceSource": { "type": ["string", "null"] },
              "priceAsOf": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "notes": { "type": "string" }
            }
          }
        },
        "frootai.tokenOps.githubOrganization": {
          "type": "string",
          "default": "",
          "pattern": "^[A-Za-z0-9-]*$",
          "description": "GitHub organization used for aggregate Copilot metrics collection."
        },
        "frootai.tokenOps.monthlyBudgetUsd": {
          "type": ["number", "null"],
          "default": null,
          "minimum": 0,
          "description": "Monthly observed-cost budget in USD. Estimated costs do not consume this budget."
        },
        "frootai.tokenOps.budgetAlertPercent": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "description": "Warn when observed month-to-date cost reaches this percentage of budget."
        }
      }
    },
