{
  "name": "frootai-webview-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && VITE_ENTRY=main vite build && VITE_ENTRY=sidebar vite build && node scripts/check-browser-bundles.mjs",
    "build:win": "tsc && set VITE_ENTRY=main&& vite build && set VITE_ENTRY=sidebar&& vite build && node scripts/check-browser-bundles.mjs",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.5"
  }
}
